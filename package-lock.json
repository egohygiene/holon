{
  "name": "@egohygiene/holon-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@egohygiene/holon-workspace",
      "workspaces": [
        "packages/*"
      ]
    },
    "node_modules/@egohygiene/repository-intelligence": {
      "resolved": "packages/repository-intelligence",
      "link": true
    },
    "packages/repository-intelligence": {
      "name": "@egohygiene/repository-intelligence",
      "version": "0.1.0-alpha.1",
      "license": "Apache-2.0",
      "bin": {
        "eh-repository-intelligence-render": "bin/render-static.mjs"
      },
      "engines": {
        "node": ">=22"
      }
    }
  }
}
