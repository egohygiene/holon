  "ownership": {
    "hygiene": "applicability, slots, evidence semantics, and claim limits",
    "identity": "banner and badge assets, descriptors, manifests, and checksums",
    "holon": "generated README region, exact plans, merge safety, and rollback",
    "repository": "facts, prose, links, commands, exceptions, opt-out, and review",
    "pace": "credential-free fleet planning and pull requests"
  },
  "markers": {
    "begin": "<!-- repository-presentation:begin owner=egohygiene/identity profile=1.0.0-alpha.1 -->",
    "end": "<!-- repository-presentation:end -->",
    "slotPrefix": "<!-- repository-presentation:slot ",
    "generatedBy": "<!-- generated-by: egohygiene/holon repository-presentation/1.0.0; edit source, not this region -->"
  },
  "merge": {
    "mode": "single-managed-region",
    "initialization": "prepend",
    "upgrade": "replace-verified-region-only",
    "authoredProse": "preserve-byte-for-byte",
    "conflict": "fail-closed",
    "preview": "unified-diff",
    "rollback": "one-level-checksum-bound"
  },
