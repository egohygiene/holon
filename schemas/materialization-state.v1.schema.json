{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/holon/materialization-state.v1.schema.json",
  "title": "Holon materialization state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "repository",
    "plan_id",
    "resolved_manifest_sha256",
    "resolved_manifest",
    "inputs",
    "managed_files",
    "rollback_manifest"
  ],
  "properties": {
    "schema_version": { "const": "holon.materialization-state/v1" },
    "engine_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "repository": { "type": "string", "pattern": "^[a-z0-9.-]+/[a-z0-9.-]+$" },
    "plan_id": { "$ref": "#/$defs/sha256" },
    "resolved_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "resolved_manifest": { "type": "object" },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "render_source",
        "aether"
      ],
      "properties": {
        "render_overlays": {
          "description": "Ordered overlay tree digests; omission is supported for saved pre-overlay plans.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tree_sha256"
            ],
            "properties": {
              "tree_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "render_source": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tree_sha256"
              ],
              "properties": {
                "tree_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          ]
        },
        "aether": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pin",
                "release_tag",
                "commit_sha",
                "projection_interface_version",
                "projection_manifest_sha256",
                "providers"
              ],
              "properties": {
                "pin": {
                  "type": "string",
                  "minLength": 1
                },
                "release_tag": {
                  "type": "string",
                  "minLength": 1
                },
                "commit_sha": {
                  "type": "string",
                  "minLength": 7
                },
                "projection_interface_version": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "projection_manifest_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "providers": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "managed_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "owner", "source"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "owner": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rollback_manifest": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
