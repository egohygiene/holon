{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/holon/architecture-decision-blueprint.v1.schema.json",
  "title": "Holon architecture-decision blueprint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "version",
    "status",
    "capability",
    "template_source",
    "render_command",
    "policy",
    "decision_directory",
    "index",
    "optional_parameters",
    "ownership",
    "files"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schema": { "const": "holon.architecture-decision-blueprint/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["active", "deprecated", "retired"] },
    "capability": { "const": "architecture-decisions" },
    "template_source": { "const": "blueprints/architecture-decisions/files" },
    "render_command": {
      "const": "python3 tools/architecture_decision_blueprint.py render-pack"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "version", "source"],
      "properties": {
        "contract": { "const": "egohygiene.architecture-decision/v1" },
        "version": { "const": "1.1.0" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "revision", "path"],
          "properties": {
            "repository": { "const": "egohygiene/hygiene" },
            "revision": { "pattern": "^[0-9a-f]{40}$" },
            "path": { "const": "docs/decisions/POLICY.md" }
          }
        }
      }
    },
    "decision_directory": { "const": "docs/decisions" },
    "index": { "const": "docs/decisions/README.md" },
    "optional_parameters": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["adr_exceptions", "adr_extensions"] }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated", "repository"],
      "properties": {
        "generated": { "$ref": "#/$defs/uniqueStrings" },
        "repository": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
